# =============================================================================
# 1. APLICAÇÃO
# =============================================================================
NODE_ENV=production
# Para logs detalhados, use NODE_ENV=development (npm run dev ativa automaticamente).
HOST=0.0.0.0
PORT=3000
PUBLIC_URL=http://localhost:3000
# Use true ao publicar com HTTPS. Número exato de proxies confiáveis (0 sem proxy).
COOKIE_SECURE=false
TRUST_PROXY_HOPS=0

# =============================================================================
# 2. ACESSO ADMINISTRATIVO E LIMITES
# =============================================================================
# Chave local para entrar em /admin. Mínimo: 32 caracteres aleatórios.
ADMIN_API_KEY=
# Criptografia dos tokens WUZAPI. Não altere após cadastrar conexões.
APP_SECRET=
# Tentativas inválidas por IP / minuto e chamadas administrativas por IP / minuto.
ADMIN_LOGIN_ATTEMPTS_PER_MINUTE=10
ADMIN_RATE_LIMIT_PER_MINUTE=120
# Tentativas públicas por IP / minuto e consultas por API key ou domínio / minuto.
PUBLIC_AUTH_ATTEMPTS_PER_MINUTE=30
RATE_LIMIT_PER_MINUTE=60

# =============================================================================
# 3. INTEGRAÇÃO WUZAPI E FOTOS
# =============================================================================
# Para WUZAPI no host do Docker: http://host.docker.internal:8080.
WUZAPI_URL=http://host.docker.internal:8080
WUZAPI_ADMIN_TOKEN=
WUZAPI_TIMEOUT_MS=15000
PHOTO_ALLOWED_HOSTS=pps.whatsapp.net,mmg.whatsapp.net
# Valor inicial; depois configure pelo painel. 0 desativa cache.
DEFAULT_CACHE_TTL_SECONDS=86400

# =============================================================================
# 4. MYSQL
# =============================================================================
# No Docker Compose, host=mysql. Para execução local, use o host do seu MySQL.
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=whatsapp_photos
MYSQL_USER=photoapi
MYSQL_PASSWORD=
# Utilizada exclusivamente pelo contêiner MySQL.
MYSQL_ROOT_PASSWORD=
MYSQL_POOL_SIZE=10
